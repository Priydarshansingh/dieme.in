# Environment variables — copy to .env.local and fill in values
# NEVER commit .env.local to git

# ── Firebase (client-side) ──────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server-side only — never expose to client) ──────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Google Drive Backend Storage (Thumbnails & Chat History) ────────────────
# 1. Create a Google Service Account in Google Cloud Console
# 2. Share your Google Drive folder with the service account email (Editor access)
# 3. Fill in the Folder ID and Service Account credentials:
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Alternative: paste raw service account JSON string:
# GOOGLE_SERVICE_ACCOUNT_KEY=

# ── AI Providers (Thumbnail Studio & Chat) ──────────────────────────────────
# Pollinations.ai (FLUX / SDXL) runs free without keys.
# Optional keys for enhanced performance:
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── YouTube OAuth ────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.dieme.in
