{
  "name": "digicast-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix digicast-web run dev",
    "dev:backend": "npm --prefix digicast-backend run dev",
    "build": "npm --prefix digicast-web run build",
    "build:backend": "npm --prefix digicast-backend run build",
    "start": "npm --prefix digicast-web run start",
    "install:web": "npm --prefix digicast-web install",
    "install:backend": "npm --prefix digicast-backend install",
    "test:phase1": "node digicast-backend/scripts/test-phase1.js"
  }
}
