{
  "$schema": "https://tr.designtokens.org/format/draft-2023-04/",
  "name": "Digicast Unified Design System",
  "version": "2.0.0",
  "color": {
    "canvas": {
      "deep": { "$value": "#07080C", "$type": "color", "description": "Root Obsidian Canvas" },
      "deck": { "$value": "#0D111A", "$type": "color", "description": "Navigation & Panel Deck" },
      "card": { "$value": "#111622", "$type": "color", "description": "Bento Container & Dialog Base" },
      "elevated": { "$value": "#161D2E", "$type": "color", "description": "Elevated Surface & Chips" }
    },
    "border": {
      "hairline": { "$value": "#1E2638", "$type": "color", "description": "Specular Card Border" },
      "active": { "$value": "#00F0FF", "$type": "color", "description": "Focus & Selection Glow" }
    },
    "text": {
      "primary": { "$value": "#F8FAFC", "$type": "color", "description": "High-emphasis White" },
      "secondary": { "$value": "#94A3B8", "$type": "color", "description": "Medium-emphasis Slate" },
      "muted": { "$value": "#64748B", "$type": "color", "description": "Disabled & Subtle Text" }
    },
    "brand": {
      "cyan": { "$value": "#00F0FF", "$type": "color", "description": "Electric Cyan Primary CTA" },
      "coral": { "$value": "#FF5C5C", "$type": "color", "description": "Live Broadcast & Moment Trigger" },
      "lime": { "$value": "#53FC18", "$type": "color", "description": "Kick Neon & Online Surge" },
      "violet": { "$value": "#A855F7", "$type": "color", "description": "AI Intelligence & Automation" },
      "amber": { "$value": "#FBBF24", "$type": "color", "description": "Superchat & Creator Support" }
    },
    "clipType": {
      "highlight": { "$value": "#10B981", "$type": "color" },
      "clutch": { "$value": "#FF725C", "$type": "color" },
      "funny": { "$value": "#06B6D4", "$type": "color" },
      "killstreak": { "$value": "#EF4444", "$type": "color" },
      "chatSpike": { "$value": "#8B5CF6", "$type": "color" },
      "custom": { "$value": "#94A3B8", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": { "$value": "Inter, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "JetBrains Mono, monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "display": { "$value": "28px", "$type": "dimension" },
      "h1": { "$value": "20px", "$type": "dimension" },
      "h2": { "$value": "16px", "$type": "dimension" },
      "body": { "$value": "14px", "$type": "dimension" },
      "caption": { "$value": "12px", "$type": "dimension" },
      "micro": { "$value": "10px", "$type": "dimension" }
    }
  },
  "borderRadius": {
    "pill": { "$value": "9999px", "$type": "dimension" },
    "card": { "$value": "16px", "$type": "dimension" },
    "button": { "$value": "12px", "$type": "dimension" },
    "chip": { "$value": "8px", "$type": "dimension" }
  }
}
