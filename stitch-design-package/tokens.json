{
  "$schema": "https://tr.designtokens.org/format/draft-2023-04/",
  "name": "Digicast Unified Design System",
  "version": "3.0.0",
  "description": "Single source of truth for colors, typography, spacing, and geometry shared across digicast-web, digicast-backend, and digicast-android. Numerology-trusted palette derived from Life Path 5, Expression 9, and the Sojat Road origin.",
  "metadata": {
    "numerology": {
      "lifePath": 5,
      "expression": 9,
      "personalYear": 1,
      "birthDate": "27-09-2003",
      "birthTime": "01:00 AM",
      "birthLocation": "Sojat Road, Pali, Rajasthan, India",
      "trustedPalette": [
        { "name": "Digital Cyan", "hex": "#00F0FF", "numerology": 5, "role": "Primary CTA / Transformation", "why": "Life Path 5 — trust, change, energy" },
        { "name": "Wisdom Violet", "hex": "#A855F7", "numerology": 9, "role": "Secondary / AI Intelligence", "why": "Expression 9 — completion, wisdom, spirituality" },
        { "name": "Desert Amber", "hex": "#FBBF24", "numerology": 3, "role": "Tertiary / Monetization", "why": "Sojat Road earth — creativity, joy, warmth" },
        { "name": "Midnight Charcoal", "hex": "#07080C", "numerology": 7, "role": "Root Canvas", "why": "Introspection — depth, mystery, grounding" },
        { "name": "Stellar Midnight", "hex": "#0F172A", "numerology": 1, "role": "Deep Deck / Foundation", "why": "1 AM new beginnings — stability, fresh start" }
      ]
    }
  },
  "color": {
    "canvas": {
      "deep": { "$value": "#07080C", "$type": "color", "description": "Root Obsidian Canvas — Midnight Charcoal (Life Path 7)", "group": "trusted" },
      "deck": { "$value": "#0D111A", "$type": "color", "description": "Navigation & Panel Deck — Stellar Midnight (1 AM birth)", "group": "trusted" },
      "card": { "$value": "#111622", "$type": "color", "description": "Bento Container & Dialog Base", "group": "trusted" },
      "elevated": { "$value": "#161D2E", "$type": "color", "description": "Elevated Surface & Chips", "group": "trusted" },
      "floating": { "$value": "#1C2333", "$type": "color", "description": "Dialog & Floating Surface", "group": "trusted" },
      "glass": { "$value": "rgba(17, 22, 34, 0.75)", "$type": "color", "description": "Frosted glass card overlay — 75% opacity over canvas-deep", "group": "trusted" }
    },
    "border": {
      "hairline": { "$value": "rgba(255, 255, 255, 0.08)", "$type": "color", "description": "Default 1px card and container specular border (8% white)", "group": "system" },
      "specular": { "$value": "#1E2638", "$type": "color", "description": "Specular border fallback (HSL dark variant)", "group": "system" },
      "active": { "$value": "rgba(0, 240, 255, 0.4)", "$type": "color", "description": "Active input focus rings, active tab indicators, selected cards", "group": "trusted" }
    },
    "text": {
      "primary": { "$value": "#F8FAFC", "$type": "color", "description": "High-emphasis text (near-white)", "group": "system" },
      "secondary": { "$value": "#94A3B8", "$type": "color", "description": "Medium-emphasis slate content", "group": "system" },
      "muted": { "$value": "#64748B", "$type": "color", "description": "Disabled & subtle text", "group": "system" }
    },
    "brand": {
      "cyan": { "$value": "#00F0FF", "$type": "color", "description": "Electric Cyan — Primary CTA, progress bars, active scrubbers. Trusted: Life Path 5", "group": "trusted" },
      "coral": { "$value": "#FF5C5C", "$type": "color", "description": "Live broadcast indicator, clutch moments, bookmark action", "group": "brand" },
      "lime": { "$value": "#53FC18", "$type": "color", "description": "Kick Neon — chat surge, online status, verified checkmarks", "group": "brand" },
      "violet": { "$value": "#A855F7", "$type": "color", "description": "AI Intelligence — automated clips, superchat telemetry, telegram sync. Trusted: Expression 9", "group": "trusted" },
      "amber": { "$value": "#FBBF24", "$type": "color", "description": "Currency & Superchat — monetization, revenue analytics. Trusted: Desert Amber (Sojat Road)", "group": "trusted" },
      "emerald": { "$value": "#10B981", "$type": "color", "description": "Highlight moments, success states", "group": "brand" }
    },
    "status": {
      "error": { "$value": "#EF4444", "$type": "color", "description": "Error & destructive actions — Crimson Red" },
      "warning": { "$value": "#F59E0B", "$type": "color", "description": "Warning states — Amber-Orange" },
      "success": { "$value": "#10B981", "$type": "color", "description": "Success states — Emerald" },
      "info": { "$value": "#00F0FF", "$type": "color", "description": "Information states — Cyan" }
    },
    "clipType": {
      "highlight": { "$value": "#10B981", "$type": "color", "description": "Highlight moments — Emerald Green", "icon": "Star" },
      "clutch": { "$value": "#FF725C", "$type": "color", "description": "Clutch plays — Sunset Coral", "icon": "Bolt" },
      "funny": { "$value": "#06B6D4", "$type": "color", "description": "Funny moments — Electric Cyan", "icon": "SentimentSatisfied" },
      "killstreak": { "$value": "#EF4444", "$type": "color", "description": "Killstreaks — Crimson Red", "icon": "Speed" },
      "chatSpike": { "$value": "#8B5CF6", "$type": "color", "description": "Chat spikes — Electric Violet", "icon": "Forum" },
      "custom": { "$value": "#94A3B8", "$type": "color", "description": "Custom bookmarks — Slate Monochrome", "icon": "ContentCut" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": { "$value": "Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif", "$type": "fontFamily", "description": "Display & Headings" },
      "body": { "$value": "Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif", "$type": "fontFamily", "description": "Body & Controls" },
      "mono": { "$value": "JetBrains Mono, Fira Code, monospace", "$type": "fontFamily", "description": "Telemetry & Numbers" }
    },
    "fontSize": {
      "display": { "$value": "28px", "$type": "dimension", "lineHeight": "34px", "weight": 800, "usage": "Hero greeting, screen titles, landing headlines" },
      "h1": { "$value": "20px", "$type": "dimension", "lineHeight": "26px", "weight": 700, "usage": "Card section titles, modal headers" },
      "h2": { "$value": "16px", "$type": "dimension", "lineHeight": "22px", "weight": 600, "usage": "Stream titles, clip labels, segment headers" },
      "body": { "$value": "14px", "$type": "dimension", "lineHeight": "20px", "weight": 400, "usage": "Standard chat messages, explanations, button labels" },
      "caption": { "$value": "12px", "$type": "dimension", "lineHeight": "16px", "weight": 500, "usage": "Timestamps, badge chips, input labels" },
      "micro": { "$value": "10px", "$type": "dimension", "lineHeight": "14px", "weight": 700, "usage": "Tag pills (HOST, BOT, LIVE), metadata tags" }
    },
    "fontWeight": {
      "display": { "$value": 800 },
      "h1": { "$value": 700 },
      "h2": { "$value": 600 },
      "body": { "$value": 400 },
      "bodyEmphasis": { "$value": 500 },
      "caption": { "$value": 500 },
      "micro": { "$value": 700 }
    }
  },
  "borderRadius": {
    "pill": { "$value": "9999px", "$type": "dimension", "usage": "Pills, badges, live dots" },
    "card": { "$value": "16px", "$type": "dimension", "usage": "Bento cards, viewports, modals" },
    "button": { "$value": "12px", "$type": "dimension", "usage": "Action buttons, inputs" },
    "chip": { "$value": "8px", "$type": "dimension", "usage": "Sub-chips, tags, small elements" },
    "input": { "$value": "10px", "$type": "dimension", "usage": "Search bars, text inputs" }
  },
  "spacing": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "xl": { "$value": "24px", "$type": "dimension" },
    "xl2": { "$value": "32px", "$type": "dimension" },
    "xl3": { "$value": "48px", "$type": "dimension" },
    "xl4": { "$value": "64px", "$type": "dimension" }
  },
  "shadow": {
    "ambientCyan": { "$value": "0 0 24px -4px rgba(0, 240, 255, 0.15)", "description": "Ambient active cyan glow" },
    "liveBroadcast": { "$value": "0 0 20px -2px rgba(255, 92, 92, 0.25)", "description": "Live broadcast glow" }
  }
}
